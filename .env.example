MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mydiaryskills

# Iron-session password (32+ chars). Generate: openssl rand -base64 32
SESSION_PASSWORD=replace-with-32-plus-character-random-string-please

# AI provider. Gemini is tried first, then Groq is used when the Gemini daily
# quota is reached or Google returns a quota/rate-limit error.
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_DAILY_LIMIT=250
