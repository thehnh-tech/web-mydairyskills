MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mydiaryskills

# Iron-session password (32+ chars). Generate: openssl rand -base64 32
SESSION_PASSWORD=replace-with-32-plus-character-random-string-please

# AI provider. Gemini is tried first, then Groq is used when Gemini is overloaded
# or quota-limited. Without Groq, the app falls back to local template analysis.
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_DAILY_LIMIT=250
